# Prefer PHP splash so security headers always apply
DirectoryIndex index.php

RewriteEngine On

# Canonical host: www → apex (chandrakalajewellers.in)
# Use 308 (not 301) so admin rate POSTs keep their body across the host redirect.
RewriteCond %{HTTP_HOST} ^www\.chandrakalajewellers\.in$ [NC]
RewriteRule ^ https://chandrakalajewellers.in%{REQUEST_URI} [L,R=308]

# Legacy static splash → homepage (keep equity on index1)
RewriteRule ^splash\.html$ https://chandrakalajewellers.in/index1 [L,R=301]

# Force HTTPS — use 308 so POST logins keep their body (301 drops POST → GET).
# Skip localhost / 127.0.0.1 so XAMPP HTTP sessions are not broken by Secure cookies.
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteCond %{HTTP_HOST} !^\[::1\] [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=308]

# AI discovery aliases under /.well-known/
RewriteRule ^\.well-known/llms\.txt$ /llms.txt [L]
RewriteRule ^\.well-known/ai\.txt$ /ai.txt [L]
RewriteRule ^\.well-known/agents\.txt$ /agents.txt [L]

# ---- Security: block hidden / sensitive files ----
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
  RewriteRule (^|/)\. - [F,L]
  RewriteRule (^|/)(debug\.log|composer\.(json|lock)|package(-lock)?\.json|\.env.*|\.git|.*\.(sql|bak|old|orig|swp|log))$ - [F,L]
</IfModule>

# Dynamic SEO files — always prefer PHP generators
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]

# Redirect browser to remove .php extension if present in the URL bar (GET requests only)
# Exclude admin directory and utility scripts so admin routing is never broken
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} !/admin [NC]
RewriteCond %{THE_REQUEST} !admin\.php [NC]
RewriteCond %{THE_REQUEST} !sitemap\.php [NC]
RewriteCond %{THE_REQUEST} !robots\.php [NC]
RewriteCond %{THE_REQUEST} !img\.php [NC]
RewriteCond %{THE_REQUEST} !index\.php [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+)\.php[?\s] [NC]
RewriteRule ^ /%1 [R=301,L]

# Silently rewrite extensionless URLs to their .php files internally
RewriteRule ^Catalogue/?$ Catalogue.php [L,NC]
RewriteRule ^admin/?$ admin/index.php [L,NC]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*?)/?$ $1.php [L]

# Admin aliases if requested extensionless or at root level
RewriteRule ^orders(\.php)?$ admin/orders.php [L,NC]
RewriteRule ^customers(\.php)?$ admin/customers.php [L,NC]
RewriteRule ^admin-orders(\.php)?$ admin/orders.php [L,NC]
RewriteRule ^admin-customers(\.php)?$ admin/customers.php [L,NC]

# PWA manifest MIME (InfinityFree often serves .webmanifest as text/plain or 404 HTML)
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/manifest+json .json
</IfModule>

# ---- Security headers (Apache/LiteSpeed when mod_headers is available) ----
<IfModule mod_headers.c>
  Header set X-Frame-Options "SAMEORIGIN"
  Header always set X-Frame-Options "SAMEORIGIN"

  Header set X-Content-Type-Options "nosniff"
  Header always set X-Content-Type-Options "nosniff"

  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  Header set Permissions-Policy "accelerometer=(), camera=(), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(), payment=(self), usb=(), interest-cohort=()"
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(), payment=(self), usb=(), interest-cohort=()"

  Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://wa.me https://api.whatsapp.com https://chandrakalajewellers.in https://www.chandrakalajewellers.in; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://www.googletagmanager.com https://www.google-analytics.com https://cdnjs.cloudflare.com https://tagmanager.google.com https://unpkg.com https://checkout.razorpay.com https://cdn.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://tagmanager.google.com https://unpkg.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://www.google-analytics.com https://www.googletagmanager.com https://region1.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://maps.googleapis.com https://maps.gstatic.com https://nominatim.openstreetmap.org https://fcm.googleapis.com https://generativelanguage.googleapis.com https://updates.push.services.mozilla.com https://*.notify.windows.com https://*.wns.windows.com https://*.push.apple.com https://api.razorpay.com https://lumberjack.razorpay.com https://lumberjack-cx.razorpay.com https://checkout.razorpay.com https://*.razorpay.com; frame-src 'self' https://www.googletagmanager.com https://www.google.com https://maps.google.com https://www.google.com/maps https://maps.googleapis.com https://www.youtube.com https://www.youtube-nocookie.com https://api.razorpay.com https://checkout.razorpay.com https://*.razorpay.com; worker-src 'self'; manifest-src 'self'"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://wa.me https://api.whatsapp.com https://chandrakalajewellers.in https://www.chandrakalajewellers.in; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://www.googletagmanager.com https://www.google-analytics.com https://cdnjs.cloudflare.com https://tagmanager.google.com https://unpkg.com https://checkout.razorpay.com https://cdn.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://tagmanager.google.com https://unpkg.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://www.google-analytics.com https://www.googletagmanager.com https://region1.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://maps.googleapis.com https://maps.gstatic.com https://nominatim.openstreetmap.org https://fcm.googleapis.com https://generativelanguage.googleapis.com https://updates.push.services.mozilla.com https://*.notify.windows.com https://*.wns.windows.com https://*.push.apple.com https://api.razorpay.com https://lumberjack.razorpay.com https://lumberjack-cx.razorpay.com https://checkout.razorpay.com https://*.razorpay.com; frame-src 'self' https://www.googletagmanager.com https://www.google.com https://maps.google.com https://www.google.com/maps https://maps.googleapis.com https://www.youtube.com https://www.youtube-nocookie.com https://api.razorpay.com https://checkout.razorpay.com https://*.razorpay.com; worker-src 'self'; manifest-src 'self'"

  Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header unset X-Powered-By
  Header always unset X-Powered-By

  <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|css|js|woff2|webmanifest)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DEBUG)$ [NC]
  RewriteRule .* - [F,L]
</IfModule>

# ---- Performance ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
