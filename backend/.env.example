# Copy to backend/.env — never commit the real file.

# PostgreSQL (Supabase / Neon / Vercel Postgres / local)
POSTGRES_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase API Keys (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth — required in production (no hardcoded fallback)
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Razorpay (optional until Super Admin keys are migrated)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public origins for CORS (comma-separated). Include frontend + admin Vercel URLs.
CORS_ORIGINS=http://localhost:8080,https://chandrakala-jewellers.vercel.app

# Optional: create the first admin only when admin_users is empty.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_ROLE=superadmin

# Public media (PHP host until files are migrated)
PUBLIC_UPLOADS_BASE=https://chandrakalajewellers.in/uploads/
PUBLIC_CATALOGUE_BASE=https://chandrakalajewellers.in/catalogue/
