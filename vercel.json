{
  "version": 2,
  "outputDirectory": "public",
  "regions": ["sin1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "includeFiles": "{*.php,*.txt,sw.js,admin/**,config/**,includes/**,api/**}",
      "maxDuration": 15
    }
  },
  "routes": [
    { "src": "^/sw\\.js$", "dest": "/sw.js" },
    { "src": "^/(css|js|images|icons|fonts)/(.*)", "dest": "/$1/$2" },
    { "src": "^/admin/(css|js|images)/(.*)", "dest": "/admin/$1/$2" },
    { "src": "^/favicon\\.(ico|png|svg)$", "dest": "/favicon.$1" },
    { "src": "^/(admin/)?(manifest|site)\\.(webmanifest|json)$", "dest": "/api/index.php" },
    { "src": "^/(.*)$", "dest": "/api/index.php" }
  ]
}
