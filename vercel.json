{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.8.0",
      "includeFiles": "{*.php,admin/**,config/**,includes/**}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|css/|js/|images/|uploads/|catalogue/|favicon|sw\\.js|manifest|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/api/index.php"
    }
  ]
}
