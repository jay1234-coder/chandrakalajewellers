{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "*.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "admin/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/catalogue/(.*)",
      "dest": "/catalogue/$1"
    },
    {
      "src": "/sw.js",
      "dest": "/sw.js"
    },
    {
      "src": "/manifest.webmanifest",
      "dest": "/manifest.webmanifest"
    },
    {
      "src": "/site.webmanifest",
      "dest": "/site.webmanifest"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.php"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/apple-touch-icon.png",
      "dest": "/apple-touch-icon.png"
    },
    {
      "src": "/about",
      "dest": "/about.php"
    },
    {
      "src": "/account",
      "dest": "/account.php"
    },
    {
      "src": "/cart",
      "dest": "/cart.php"
    },
    {
      "src": "/checkout",
      "dest": "/checkout.php"
    },
    {
      "src": "/contact",
      "dest": "/contact.php"
    },
    {
      "src": "/gallery",
      "dest": "/gallery.php"
    },
    {
      "src": "/product",
      "dest": "/product.php"
    },
    {
      "src": "/catalogue",
      "dest": "/Catalogue.php"
    },
    {
      "src": "/admin",
      "dest": "/admin.php"
    },
    {
      "src": "/superadmin",
      "dest": "/superadmin.php"
    },
    {
      "src": "/gold-rate-khedbrahma",
      "dest": "/gold-rate-khedbrahma.php"
    },
    {
      "src": "/jewellers-in-khedbrahma",
      "dest": "/jewellers-in-khedbrahma.php"
    },
    {
      "src": "/wishlist",
      "dest": "/wishlist.php"
    },
    {
      "src": "/buynow",
      "dest": "/buynow.php"
    },
    {
      "src": "/pay",
      "dest": "/pay.php"
    },
    {
      "src": "/success",
      "dest": "/success.php"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*).php",
      "dest": "/$1.php"
    },
    {
      "src": "/",
      "dest": "/index.php"
    }
  ]
}
